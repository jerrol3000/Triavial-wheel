# Copy to .env and fill in real values for production.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/trivia.db

# Stripe — leave blank for dev. The frontend Pro button falls back to a placeholder URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:8080/?pro=success
STRIPE_CANCEL_URL=http://localhost:8080/?pro=cancel

# CORS — comma-separated origins allowed to call this API in production.
CORS_ORIGIN=http://localhost:8080

# Admin — comma-separated list of emails. Any user with one of these emails is granted admin
# rights on register (and existing users are promoted on every server boot).
ADMIN_EMAILS=admin@example.com

# ── Master encryption key for admin-editable settings (PayPal/Stripe creds) ──
# 64-char hex (32 bytes) OR any passphrase. Required to use the admin Settings
# panel. KEEP THIS OUT OF THE DATABASE. Without it, the DB contains only
# encrypted blobs — a DB leak doesn't expose your payment credentials.
# Generate one: `openssl rand -hex 32`
ADMIN_SETTINGS_KEY=

# Disable opentdb background refresh (useful for tests / offline dev).
# DISABLE_QUESTION_REFRESH=1

# ── PayPal (real billing) ──────────────────────────────────────────────────
# To take real payments for coin/powerup/spin packs:
#   1. Create a PayPal Business account
#   2. https://developer.paypal.com → Apps & Credentials → Create REST app
#   3. Copy the Client ID + Secret here
#   4. Use PAYPAL_MODE=sandbox while testing with the sandbox accounts PayPal
#      generates for you; switch to PAYPAL_MODE=live when ready to take money.
# Without these, the Shop falls back to dev-grant (instant grant for UI testing).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
