# Copy to .env and fill in real values for production.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/trivia.db

# Stripe — leave blank for dev. The frontend Pro button falls back to a placeholder URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:8080/?pro=success
STRIPE_CANCEL_URL=http://localhost:8080/?pro=cancel

# CORS — comma-separated origins allowed to call this API in production.
CORS_ORIGIN=http://localhost:8080

# Admin — comma-separated list of emails. Any user with one of these emails is granted admin
# rights on register (and existing users are promoted on every server boot).
ADMIN_EMAILS=admin@example.com

# Disable opentdb background refresh (useful for tests / offline dev).
# DISABLE_QUESTION_REFRESH=1
