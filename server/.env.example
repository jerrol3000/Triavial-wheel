# ───────────────────────────────────────────────────────────────────────────
# Trivia Wheel — server environment template.
# Copy to `.env` and fill in the values you need. Anything left blank uses a
# sensible default (development) or is reported via the startup preflight
# check (production).
# ───────────────────────────────────────────────────────────────────────────

# Core
PORT=4000
NODE_ENV=development                # set to "production" on your hosting platform
APP_VERSION=dev                     # surfaced in /api/health for deploy verification

# Database — SQLite file. On Fly/Render with a volume, point this at the mount:
#   DB_PATH=/data/trivia.db
DB_PATH=./data/trivia.db

# ── Required in production ────────────────────────────────────────────────
# JWT signing secret. Without this set, the server falls back to an insecure
# default in dev. In production the preflight check refuses to boot.
# Generate one: `openssl rand -hex 32`
JWT_SECRET=

# CORS — comma-separated list of allowed origins. Leave as * for dev; pin to
# your real frontend domain in production (e.g. https://yoursite.netlify.app).
CORS_ORIGIN=http://localhost:8080

# Admin — comma-separated list of emails. Any user registering with one of
# these emails is auto-promoted to admin. Existing matching users are
# promoted on every server boot.
ADMIN_EMAILS=

# Master encryption key for admin-editable settings (PayPal/Stripe creds).
# 64-char hex OR any passphrase. Required to use the admin Settings panel.
# KEEP THIS OUT OF THE DATABASE. Without it, the DB contains only encrypted
# blobs — a DB leak doesn't expose your payment credentials.
# Generate one: `openssl rand -hex 32`
ADMIN_SETTINGS_KEY=

# ── Payments (optional — also configurable from the admin Settings panel) ──
# Env vars take priority over admin-panel values. Recommend leaving these
# blank and using the admin panel so credential rotation needs no redeploy.

# PayPal Smart Buttons. Get from https://developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                 # "live" when going live

# Stripe (alternative to PayPal; both can coexist). From dashboard.stripe.com.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:8080/?pro=success
STRIPE_CANCEL_URL=http://localhost:8080/?pro=cancel

# ── Question bank refresh from Open Trivia DB ─────────────────────────────
# Set to "1" to disable the 6-hour background top-up loop. Useful in tests
# and offline development.
# DISABLE_QUESTION_REFRESH=1
